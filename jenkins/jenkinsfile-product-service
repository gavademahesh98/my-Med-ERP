pipeline{
    agent{
        label 'worker'
    }
    tools{
        maven 'mvn'
        jdk 'java17'
    }
    parameters {
        choice(
            name: 'ENV',
            choices: ['dev', 'qa'],
            description: 'Deployment environment'
        )
    }
    environment{
        aws_cred=credentials('aws-cred')
        REPO="655887417250.dkr.ecr.ap-southeast-1.amazonaws.com/${params.ENV}-product-service"
    }
    stages{
        stage('checkout-scm'){
            steps{
                git branch: "${params.ENV}", url: 'https://github.com/gavademahesh98/my-Med-ERP.git'
            }
        }
        stage('maven-build'){
            steps{
                dir('product-service'){
                    sh 'mvn clean package'
                }
            }
            post{
                success{
                    archiveArtifacts artifacts: '**product-service/target/*.jar' , fingerprint: true 
                }
            }
        }
        stage('sonar-scan'){
            steps{
                dir('product-service'){
                    withSonarQubeEnv('sonar-server'){
                       sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                    }
                }
            }
        }
        stage('quality-Gate'){
            steps{
                timeout(time: 5, unit:'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
                post {

                        failure {
                            script {

                                def sonarProperties =
                                    readProperties file: 'product-service/target/sonar/report-task.txt'

                                def sonarIssuesUrl =
                                    "${sonarProperties.serverUrl}/project/issues?id=${URLEncoder.encode(sonarProperties.projectKey, 'UTF-8')}"

                                emailext(
                                    subject: "SonarQube Quality Gate Failed - ${env.JOB_NAME} #${env.BUILD_NUMBER}",

                                    body: """
                                        <p>SonarQube Quality Gate failed.</p>
                                        <p>
                                            <a href="${sonarIssuesUrl}">
                                                <b>View SonarQube Issues Report</b>
                                            </a>
                                        </p>
                                    """,

                                    mimeType: 'text/html',

                                    to: 'msgavade1111@gmail.com'
                                )
                            }
                        }
                }
        }
        stage('artifacts to s3'){
            steps{
                sh "aws s3 cp product-service/target/*.jar  s3://${params.ENV}-product-service-artifacts/"
            }
        }
        stage('docker-build-service'){
            steps{
                dir('product-service'){
                    sh "docker build -t ${params.ENV}-product-service:${BUILD_NUMBER} . "
                    sh 'docker images'
                }
            }
        }
        stage('Trivy Scan') {
            steps {
                lock('git-push') {

                // Generate Jenkins-readable ASCII report
                sh """
                    TMPDIR=/var/lib/trivy-tmp trivy image \
                        --cache-dir=/var/lib/trivy-cache \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --format table \
                        ${params.ENV}-product-service:${BUILD_NUMBER} \
                        | iconv -f UTF-8 -t ASCII//TRANSLIT \
                        > trivy-report.txt
                """

                // Security gate
                sh """
                    TMPDIR=/var/lib/trivy-tmp trivy image \
                        --cache-dir=/var/lib/trivy-cache \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --exit-code 0 \
                        ${params.ENV}-product-service:${BUILD_NUMBER}
                """
                } 
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'trivy-report.txt',
                        fingerprint: true,
                        allowEmptyArchive: false
                    )
                }
            }
        }
        stage('image push to ECR'){
            steps{
                sh """
                aws ecr get-login-password --region ap-southeast-1 | \
                docker login --username AWS --password-stdin \
                655887417250.dkr.ecr.ap-southeast-1.amazonaws.com

                docker tag ${params.ENV}-product-service:${BUILD_NUMBER} ${REPO}:${BUILD_NUMBER}
                docker push ${REPO}:${BUILD_NUMBER}
                 echo "Cleaning unused Docker images..."
                 docker rmi ${REPO}:${BUILD_NUMBER}
                 docker rmi ${params.ENV}-product-service:${BUILD_NUMBER}

                """
            }
        }
        
        stage('Update Helm Values for GitOps'){
            steps{
                sh """
                   set -eu

            VALUES_FILE="helm/product-service/values.yaml"

            sed -i \
              "s|^[[:space:]]*repository:.*|  repository: \\"${REPO}\\"|" \
              "\${VALUES_FILE}"

            sed -i \
              "s|^[[:space:]]*tag:.*|  tag: \\"${BUILD_NUMBER}\\"|" \
              "\${VALUES_FILE}"

            git diff -- "\${VALUES_FILE}"

                """
            }
        }
        stage('Push-change-in values.yaml'){
            steps{
                lock('git-push') {
                withCredentials([usernamePassword(
                credentialsId: 'github-cred',
                usernameVariable: 'GIT_USERNAME',
                passwordVariable: 'GIT_PASSWORD'
            )]) {
                sh """
                    set -eu

                    git config user.name "Jenkins"
                    git config user.email "jenkins@gmail.com"

                    git add helm/product-service/values.yaml

                    if git diff --cached --quiet; then
                    echo "No changes to commit"
                    exit 0
                    fi


                    git commit -m "Update product-service image tag"

                    git pull --rebase origin ${params.ENV}

                    git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/gavademahesh98/my-Med-ERP.git HEAD:${params.ENV}
                """
            }
            }
            }
        }
    }
}