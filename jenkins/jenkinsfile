pipeline{
    agent{
        label 'worker'
    }
    tools{
        maven 'mvn'
        jdk 'java17'
    }
    parameters {
    choice(
        name: 'SERVICE',
        choices: [
            'user-service',
            'product-service',
            'order-service'
        ],
        description: 'Select the service to build and deploy'
    )
    choice(
            name: 'ENV',
            choices: ['dev', 'qa'],
            description: 'Deployment environment'
        )

}
    environment{
        aws_cred=credentials('aws-cred')
        REPO = "655887417250.dkr.ecr.ap-southeast-1.amazonaws.com/${params.ENV}-${params.SERVICE}"
    }
    stages{
        stage('checkout-scm'){
            steps{
                git branch: "${params.ENV}", url: 'https://github.com/gavademahesh98/my-Med-ERP.git'
            }
        }
        stage('maven-build'){
            steps{
                dir("${params.SERVICE}"){
                    sh 'mvn clean package'
                }
            }
            post{
                success{
                    archiveArtifacts artifacts: "**${params.SERVICE}/target/*.jar" , fingerprint: true 
                }
            }
        }
        stage('sonar-scan'){
            steps{
                dir("${params.SERVICE}"){
                    withSonarQubeEnv('sonar-server'){
                       sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                    }
                }
            }
        }
        stage('quality-Gate'){
            steps{
                timeout(time: 5, unit:'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
                post {

                        failure {
                            script {

                                def sonarProperties =
                                    readProperties file: "${params.SERVICE}/target/sonar/report-task.txt"

                                def sonarIssuesUrl =
                                    "${sonarProperties.serverUrl}/project/issues?id=${URLEncoder.encode(sonarProperties.projectKey, 'UTF-8')}"

                                emailext(
                                    subject: "SonarQube Quality Gate Failed - ${params.SERVICE} #${env.BUILD_NUMBER}",

                                    body: """
                                        <p>SonarQube Quality Gate failed.</p>
                                        <p>
                                            <a href="${sonarIssuesUrl}">
                                                <b>View SonarQube Issues Report</b>
                                            </a>
                                        </p>
                                    """,

                                    mimeType: 'text/html',

                                    to: 'msgavade1111@gmail.com'
                                )
                            }
                        }
                }
        }
        stage('artifacts to s3'){
            steps{
                sh "aws s3 cp ${params.SERVICE}/target/*.jar  s3://${params.ENV}-${params.SERVICE}-artifacts/"
            }
        }
        stage('docker-build-service'){
            steps{
                dir("${params.SERVICE}"){
                    sh "docker build -t ${params.ENV}-${params.SERVICE}:${BUILD_NUMBER} . "
                    sh 'docker images'
                }
            }
        }
        stage('Trivy Scan') {
            steps {

                // Generate Jenkins-readable ASCII report
                sh """
                    TMPDIR=/var/lib/trivy-tmp trivy image \
                        --cache-dir=/var/lib/trivy-cache \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --format table \
                        ${params.ENV}-${params.SERVICE}:${BUILD_NUMBER} \
                        | iconv -f UTF-8 -t ASCII//TRANSLIT \
                        > trivy-report.txt
                """

                // Security gate
                sh """
                    TMPDIR=/var/lib/trivy-tmp trivy image \
                        --cache-dir=/var/lib/trivy-cache \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --exit-code 0 \
                        ${params.ENV}-${params.SERVICE}:${BUILD_NUMBER}
                """
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'trivy-report.txt',
                        fingerprint: true,
                        allowEmptyArchive: false
                    )
                }
            }
        }
        stage('image push to ECR'){
            steps{
                sh """
                aws ecr get-login-password --region ap-southeast-1 | \
                docker login --username AWS --password-stdin \
                655887417250.dkr.ecr.ap-southeast-1.amazonaws.com

                docker tag ${params.ENV}-${params.SERVICE}:${BUILD_NUMBER} ${REPO}:${BUILD_NUMBER}
                docker push ${REPO}:${BUILD_NUMBER}
                 echo "Cleaning unused Docker images..."
                 docker rmi ${REPO}:${BUILD_NUMBER}
                 docker rmi ${params.ENV}-${params.SERVICE}:${BUILD_NUMBER}
                """
            }
        }
        stage('Deployment'){
            steps{
                sh """
                    aws eks update-kubeconfig \
                   --region ap-southeast-1 \
                   --name dev-cluster
                   
                   helm upgrade --install med-erp-common ./helm/common \
                   --namespace ${params.ENV} \
                   --create-namespace

                   helm upgrade --install ${params.SERVICE} ./helm/${params.SERVICE} \
                   --namespace ${params.ENV} \
                   --create-namespace \
                   --set-string image.repository="${REPO}" \
                   --set-string image.tag="${BUILD_NUMBER}"

                """
            }
        }
    }
}