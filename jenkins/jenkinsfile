pipeline{
    agent{
        label 'worker'
    }
    tools{
        maven 'mvn'
        jdk 'java17'
    }
    parameters {
    choice(
        name: 'SERVICE',
        choices: [
            'user-service',
            'product-service',
            'order-service'
        ],
        description: 'Select the service to build and deploy'
    )
}
    environment{
        aws_cred=credentials('aws-cred')
        REPO="655887417250.dkr.ecr.ap-southeast-1.amazonaws.com/dev-${params.SERVICE}"
    }
    stages{
        stage('checkout-scm'){
            steps{
                git branch: 'dev', url: 'https://github.com/gavademahesh98/my-Med-ERP.git'
            }
        }
        stage('maven-build'){
            steps{
                dir("${params.SERVICE}"){
                    sh 'mvn clean package'
                }
            }
            post{
                success{
                    archiveArtifacts artifacts: "**${params.SERVICE}/target/*.jar" , fingerprint: true 
                }
            }
        }
        stage('sonar-scan'){
            steps{
                dir("${params.SERVICE}"){
                    withSonarQubeEnv('sonar-server'){
                       sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                    }
                }
            }
        }
        stage('quality-Gate'){
            steps{
                timeout(time: 5, unit:'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
                post {

                        failure {
                            script {

                                def sonarProperties =
                                    readProperties file: "${params.SERVICE}/target/sonar/report-task.txt"

                                def sonarIssuesUrl =
                                    "${sonarProperties.serverUrl}/project/issues?id=${URLEncoder.encode(sonarProperties.projectKey, 'UTF-8')}"

                                emailext(
                                    subject: "SonarQube Quality Gate Failed - ${params.SERVICE} #${env.BUILD_NUMBER}",

                                    body: """
                                        <p>SonarQube Quality Gate failed.</p>
                                        <p>
                                            <a href="${sonarIssuesUrl}">
                                                <b>View SonarQube Issues Report</b>
                                            </a>
                                        </p>
                                    """,

                                    mimeType: 'text/html',

                                    to: 'msgavade1111@gmail.com'
                                )
                            }
                        }
                }
        }
        stage('artifacts to s3'){
            steps{
                sh "aws s3 cp ${params.SERVICE}/target/*.jar  s3://dev-${params.SERVICE}-artifacts/"
            }
        }
        stage('docker-build-service'){
            steps{
                dir("${params.SERVICE}"){
                    sh "docker build -t dev-${params.SERVICE}:${BUILD_NUMBER} . "
                    sh 'docker images'
                }
            }
        }
        stage('Trivy Scan') {
            steps {

                // Generate Jenkins-readable ASCII report
                sh """
                    TMPDIR=/var/lib/trivy-tmp trivy image \
                        --cache-dir=/var/lib/trivy-cache \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --format table \
                        dev-${params.SERVICE}:${BUILD_NUMBER} \
                        | iconv -f UTF-8 -t ASCII//TRANSLIT \
                        > trivy-report.txt
                """

                // Security gate
                sh """
                    TMPDIR=/var/lib/trivy-tmp trivy image \
                        --cache-dir=/var/lib/trivy-cache \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --exit-code 0 \
                        dev-${params.SERVICE}:${BUILD_NUMBER}
                """
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'trivy-report.txt',
                        fingerprint: true,
                        allowEmptyArchive: false
                    )
                }
            }
        }
        stage('image push to ECR'){
            steps{
                sh """
                aws ecr get-login-password --region ap-southeast-1 | \
                docker login --username AWS --password-stdin \
                655887417250.dkr.ecr.ap-southeast-1.amazonaws.com

                docker tag dev-${params.SERVICE}:${BUILD_NUMBER} ${REPO}:${BUILD_NUMBER}
                docker push ${REPO}:${BUILD_NUMBER}
                 echo "Cleaning unused Docker images..."
                 docker rmi ${REPO}:${BUILD_NUMBER}
                """
            }
        }
        stage('image change in deployment'){
            steps{
                sh """
                sed -i "s|image: .*|image: $REPO:$BUILD_NUMBER|" k8s/deployments/${params.SERVICE}-deployment.yaml
                """
            }
        }
        stage('Image update push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-cred',
                        usernameVariable: 'USERNAME',
                        passwordVariable: 'PASSWORD'
                    )
                ]) {
                    lock(resource: 'git-push'){
                    sh """
                        git config --global user.name "jenkins_build_$BUILD_NUMBER"
                        git config --global user.email "jenkins.buildnumber_$BUILD_NUMBER@gmail.com"

                        git add k8s/deployments/${params.SERVICE}-deployment.yaml

                        git commit -m "Update ${params.SERVICE} image to build $BUILD_NUMBER" || true
                        
                        git pull --rebase origin dev

                        git push https://$USERNAME:$PASSWORD@github.com/gavademahesh98/my-Med-ERP.git HEAD:dev
                      """
                    }
                    }
            }
        }
        stage("deployment"){
            steps{
                
                sh """
                aws eks update-kubeconfig --region ap-southeast-1 --name dev-cluster
                kubectl apply -f k8s/namespace/
                kubectl apply -f k8s/configmaps/
                kubectl apply -f k8s/secrets/
                kubectl apply -f k8s/deployments/${params.SERVICE}-deployment.yaml
                kubectl apply -f k8s/services/
                kubectl apply -f k8s/hpa/
                kubectl apply -f k8s/ingress/
                """
                
            }
        }
    }
}