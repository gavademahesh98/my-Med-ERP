pipeline{
    agent{
        label 'worker'
    }
    tools{
        nodejs 'nodejs'
        maven 'mvn'
    }
    environment{
        aws_cred=credentials('aws-cred')
    }
    stages{
        stage('checkout'){
            steps{
                git branch: 'dev', url: 'https://github.com/gavademahesh98/my-Med-ERP.git'
            }
        }
        stage('build-frontend'){
            steps{
                dir('frontend'){
                    sh '''
                    npm install
                    npm run build
                    '''
                }
            }
            post{
                success{
                    archiveArtifacts artifacts: 'frontend/dist/**' , fingerprint: true
                }
            }
        }
        stage('sonar-scan'){
            steps{
                dir('frontend'){
                    withSonarQubeEnv('sonar-server'){
                        sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                    }
                }
            }
        }
    }
}