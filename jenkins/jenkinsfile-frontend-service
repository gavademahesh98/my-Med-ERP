pipeline{
    agent{
        label 'worker'
    }
    tools{
        nodejs 'nodejs'
    }
    environment{
        aws_cred=credentials('aws-cred')
    }
    stages{
        stage('checkout'){
            steps{
                git branch: 'dev', url: 'https://github.com/gavademahesh98/my-Med-ERP.git'
            }
        }
        stage('build-frontend'){
            steps{
                dir('frontend'){
                    sh '''
                    npm install
                    npm run build
                    '''
                }
            }
        }
    }
}