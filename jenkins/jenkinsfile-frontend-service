pipeline{
    agent{
        label 'worker'
    }
    tools{
        nodejs 'nodejs'
        maven 'mvn'
    }
    environment{
        aws_cred=credentials('aws-cred')
    }
    stages{
        stage('checkout'){
            steps{
                git branch: 'dev', url: 'https://github.com/gavademahesh98/my-Med-ERP.git'
            }
        }
        stage('build-frontend'){
            steps{
                dir('frontend'){
                    sh '''
                    npm install
                    npm run build
                    '''
                }
            }
            post{
                success{
                    archiveArtifacts artifacts: 'frontend/dist/**' , fingerprint: true
                }
            }
        }
        stage('Sonar Scan') {
            steps {
                dir('frontend') {
                    withSonarQubeEnv('sonar-server') {
                        script {
                            def scannerHome = tool(
                                name: 'sonar-scanner',
                                type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                            )

                            sh "${scannerHome}/bin/sonar-scanner"
                        }
                    }
                }
            }
        }
        stage('Quality Gate'){
            steps{
                timeout(time: 5 , unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
            post {

                        failure {
                            script {

                                def sonarProperties =
                                    readProperties file: 'frontend/.scannerwork/report-task.txt'

                                def sonarIssuesUrl =
                                    "${sonarProperties.serverUrl}/project/issues?id=${URLEncoder.encode(sonarProperties.projectKey, 'UTF-8')}"

                                emailext(
                                    subject: "SonarQube Quality Gate Failed - ${env.JOB_NAME} #${env.BUILD_NUMBER}",

                                    body: """
                                        <p>SonarQube Quality Gate failed.</p>
                                        <p>
                                            <a href="${sonarIssuesUrl}">
                                                <b>View SonarQube Issues Report</b>
                                            </a>
                                        </p>
                                    """,

                                    mimeType: 'text/html',

                                    to: 'msgavade1111@gmail.com'
                                )
                            }
                        }
                }
        }
    }
}