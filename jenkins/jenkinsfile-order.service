pipeline{
    agent{
        label 'worker'
    }
    tools{
        maven 'mvn'
        jdk 'java17'
    }
    environment{
        aws_cred=credentials('aws-cred')
        REPO='655887417250.dkr.ecr.ap-southeast-1.amazonaws.com/dev-product-service'
    }
    stages{
        stage('checkout-scm'){
            steps{
                git branch: 'dev', url: 'https://github.com/gavademahesh98/my-Med-ERP.git'
            }
        }
        stage('maven-build'){
            steps{
                dir('product-service'){
                    sh 'mvn clean package'
                }
            }
            post{
                success{
                    archiveArtifacts artifacts: '**product-service/target/*.jar' , fingerprint: true 
                }
            }
        }
        stage('sonar-scan'){
            steps{
                dir('product-service'){
                    withSonarQubeEnv('sonar-server'){
                       sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                    }
                }
            }
        }
        stage('quality-Gate'){
            steps{
                timeout(time: 5, unit:'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
                post {

                        failure {
                            script {

                                def sonarProperties =
                                    readProperties file: 'product-service/target/sonar/report-task.txt'

                                def sonarIssuesUrl =
                                    "${sonarProperties.serverUrl}/project/issues?id=${URLEncoder.encode(sonarProperties.projectKey, 'UTF-8')}"

                                emailext(
                                    subject: "SonarQube Quality Gate Failed - ${env.JOB_NAME} #${env.BUILD_NUMBER}",

                                    body: """
                                        <p>SonarQube Quality Gate failed.</p>
                                        <p>
                                            <a href="${sonarIssuesUrl}">
                                                <b>View SonarQube Issues Report</b>
                                            </a>
                                        </p>
                                    """,

                                    mimeType: 'text/html',

                                    to: 'msgavade1111@gmail.com'
                                )
                            }
                        }
                }
        }
        stage('artifacts to s3'){
            steps{
                sh 'aws s3 cp product-service/target/*.jar  s3://dev-product-service-artifacts/'
            }
        }
        stage('docker-build-service'){
            steps{
                dir('product-service'){
                    sh "docker build -t dev-product-service:${BUILD_NUMBER} . "
                    sh 'docker images'
                }
            }
        }
        stage('Trivy Scan') {
            steps {

                // Generate Jenkins-readable ASCII report
                sh """
                    TMPDIR=/var/lib/trivy-tmp trivy image \
                        --cache-dir=/var/lib/trivy-cache \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --format table \
                        dev-product-service:${BUILD_NUMBER} \
                        | iconv -f UTF-8 -t ASCII//TRANSLIT \
                        > trivy-report.txt
                """

                // Security gate
                sh """
                    TMPDIR=/var/lib/trivy-tmp trivy image \
                        --cache-dir=/var/lib/trivy-cache \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --exit-code 0 \
                        dev-product-service:${BUILD_NUMBER}
                """
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'trivy-report.txt',
                        fingerprint: true,
                        allowEmptyArchive: false
                    )
                }
            }
        }
        stage('image push to ECR'){
            steps{
                sh """
                aws ecr get-login-password --region ap-southeast-1 | \
                docker login --productname AWS --password-stdin \
                655887417250.dkr.ecr.ap-southeast-1.amazonaws.com

                docker tag dev-product-service:${BUILD_NUMBER} ${REPO}:${BUILD_NUMBER}
                docker push ${REPO}:${BUILD_NUMBER}
                 echo "Cleaning unused Docker images..."
                 docker image prune -a -f
                """
            }
        }
        stage('image change in deployment'){
            steps{
                sh 'sed -i "s|image: .*|image: $REPO:$BUILD_NUMBER|" k8s/deployments/product-service-deployment.yaml '
            }
        }
        stage('Image update push') {
            steps {
                withCredentials([
                    productnamePassword(
                        credentialsId: 'github-cred',
                        productnameVariable: 'productNAME',
                        passwordVariable: 'PASSWORD'
                    )
                ]) {
                    sh '''
                        git config --global product.name "jenkins_build_$BUILD_NUMBER"
                        git config --global product.email "jenkins.buildnumber_$BUILD_NUMBER@gmail.com"

                        git add k8s/deployments/product-service-deployment.yaml

                        git commit -m "Update product-service image to build $BUILD_NUMBER" || true

                        git push https://$productNAME:$PASSWORD@github.com/gavademahesh98/my-Med-ERP.git HEAD:dev
                      '''
                    }
            }
        }      
    }
}